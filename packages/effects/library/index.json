{
  "version": 1,
  "note": "Gold effect modules bundled offline. Adding a library is a data-only change: a new row here plus the module file it points at. Every library a module touches is recorded with its licence.",
  "adapters": {
    "kit": "The @chair/effects kit itself (seek helpers, presets, physics). Chair, own work.",
    "ogl": "OGL minimal WebGL. Unlicense.",
    "motion": "Motion (motion.dev) 14.x. MIT.",
    "anime": "anime.js v4. MIT.",
    "matter": "matter-js. MIT.",
    "paper": "@paper-design/shaders 0.0.82. Apache-2.0.",
    "flubber": "flubber. MIT.",
    "transitions": "gl-transitions (check the bundled transition's file header). MIT."
  },
  "entries": [
    {
      "id": "liquid-boxes",
      "tags": ["liquid", "metaballs", "sdf", "ogl", "paper", "motion", "background", "generator"],
      "summary": "Two boxes orbit, touch, and merge through a smooth-min SDF rendered by OGL, with a Paper grain-gradient on top; per-box phase from Motion stagger.",
      "props": [
        { "id": "spread", "type": "number" },
        { "id": "speed", "type": "number" },
        { "id": "merge", "type": "number" },
        { "id": "size", "type": "number" },
        { "id": "grain", "type": "number" },
        { "id": "ink", "type": "color" },
        { "id": "accent", "type": "color" },
        { "id": "paper", "type": "color" }
      ],
      "source": "ogl",
      "libraries": [
        { "name": "ogl", "license": "Unlicense" },
        { "name": "motion", "license": "MIT" },
        { "name": "@paper-design/shaders", "license": "Apache-2.0" }
      ],
      "license": "Unlicense",
      "path": "library/liquid-boxes.tsx"
    },
    {
      "id": "dither-reveal",
      "tags": ["dither", "reveal", "paper", "title", "generator"],
      "summary": "A Paper dithering shader wiped away over seconds to reveal the title; pattern, cell, flow, and wipe duration are Inspector controls.",
      "props": [
        { "id": "colorBack", "type": "color" },
        { "id": "colorFront", "type": "color" },
        { "id": "shape", "type": "number" },
        { "id": "size", "type": "number" },
        { "id": "speed", "type": "number" },
        { "id": "reveal", "type": "number" },
        { "id": "label", "type": "string" }
      ],
      "source": "paper",
      "libraries": [{ "name": "@paper-design/shaders", "license": "Apache-2.0" }],
      "license": "Apache-2.0",
      "path": "library/dither-reveal.tsx"
    },
    {
      "id": "lower-third",
      "tags": ["motion", "spring", "stagger", "title", "lower-third", "overlay"],
      "summary": "Kicker, title, and rule slide in on a fixed-step spring with Motion stagger delays and a faint idle float; the client seeks a paused Motion animation.",
      "props": [
        { "id": "kicker", "type": "string" },
        { "id": "title", "type": "string" },
        { "id": "sub", "type": "string" },
        { "id": "size", "type": "number" },
        { "id": "slide", "type": "number" },
        { "id": "speed", "type": "number" },
        { "id": "accent", "type": "color" },
        { "id": "ink", "type": "color" }
      ],
      "source": "motion",
      "libraries": [
        { "name": "motion", "license": "MIT" },
        { "name": "@chair/effects", "license": "Chair, own work" }
      ],
      "license": "MIT",
      "path": "library/lower-third.tsx"
    },
    {
      "id": "physics-letters",
      "tags": ["physics", "matter", "anime", "stagger", "letters", "title", "generator"],
      "summary": "The word rains from above on a seeded matter-js simulation, letters released with anime stagger delays and spin, landing on a baseline.",
      "props": [
        { "id": "word", "type": "string" },
        { "id": "gravity", "type": "number" },
        { "id": "drop", "type": "number" },
        { "id": "spin", "type": "number" },
        { "id": "size", "type": "number" },
        { "id": "accent", "type": "color" },
        { "id": "ink", "type": "color" },
        { "id": "paper", "type": "color" }
      ],
      "source": "matter",
      "libraries": [
        { "name": "matter-js", "license": "MIT" },
        { "name": "animejs", "license": "MIT" }
      ],
      "license": "MIT",
      "path": "library/physics-letters.tsx"
    },
    {
      "id": "morph-icon",
      "tags": ["flubber", "morph", "icon", "glow", "generator"],
      "summary": "One path breathes between circle, star, and square on a flubber interpolation, wrapped in the kit glow; blend, stroke, and speed are controls.",
      "props": [
        { "id": "speed", "type": "number" },
        { "id": "size", "type": "number" },
        { "id": "thickness", "type": "number" },
        { "id": "glow", "type": "number" },
        { "id": "accent", "type": "color" },
        { "id": "paper", "type": "color" }
      ],
      "source": "flubber",
      "libraries": [
        { "name": "flubber", "license": "MIT" },
        { "name": "@chair/effects", "license": "Chair, own work" }
      ],
      "license": "MIT",
      "path": "library/morph-icon.tsx"
    },
    {
      "id": "mesh-gradient",
      "tags": ["paper", "mesh-gradient", "background", "generator"],
      "summary": "A Paper mesh-gradient background with four editor colors, distortion, swirl, and grain; speed parks and seeks the mount frame.",
      "props": [
        { "id": "colorA", "type": "color" },
        { "id": "colorB", "type": "color" },
        { "id": "colorC", "type": "color" },
        { "id": "colorD", "type": "color" },
        { "id": "distortion", "type": "number" },
        { "id": "swirl", "type": "number" },
        { "id": "speed", "type": "number" },
        { "id": "grain", "type": "number" }
      ],
      "source": "paper",
      "libraries": [{ "name": "@paper-design/shaders", "license": "Apache-2.0" }],
      "license": "Apache-2.0",
      "path": "library/mesh-gradient.tsx"
    }
  ]
}
