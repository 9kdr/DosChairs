{
  "name": "@chair/effects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/ograf.ts",
    "./kit": "./src/kit/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:modules": "vitest run --config ../../vitest.config.ts src/modules",
    "modules:cli": "esbuild src/modules/cli.ts --bundle --platform=node --format=esm --outfile=build/modules-cli.mjs --external:esbuild --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --log-level=warning"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.187.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@chair/ograf": "workspace:^",
    "@paper-design/shaders": "0.0.82",
    "animejs": "^4.5.0",
    "flubber": "^0.4.2",
    "gl-transitions": "2.4.0",
    "matter-js": "^0.20.0",
    "motion": "14.0.0",
    "ogl": "^1.0.11",
    "open-bot-avatar": "0.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shaders": "4.0.6",
    "three": "^0.180.0"
  }
}
