# Copy to .env — mise loads it automatically via [env] in mise.toml
# Never commit real secrets.

# Meta Model API (Muse Wonder / Spark / transcription)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Agent runtime
CUTROOM_AGENT_HOST=127.0.0.1
CUTROOM_AGENT_PORT=8787
CUTROOM_PLANNER_MODEL=muse-wonder-1.0
CUTROOM_EXECUTOR_MODEL=muse-spark-1
CUTROOM_VERIFIER_MODEL=muse-spark-1

# Model sidecar (SAM family + ffmpeg helpers)
CUTROOM_SIDECAR_HOST=127.0.0.1
CUTROOM_SIDECAR_PORT=8788
CUTROOM_SIDECAR_DEVICE=cuda
CUTROOM_WEIGHTS_DIR=./data/weights

# Desktop ↔ services
CUTROOM_PROJECTS_DIR=./data/projects
CUTROOM_PROXY_DIR=./data/proxies
VITE_AGENT_URL=http://127.0.0.1:8787
VITE_SIDECAR_URL=http://127.0.0.1:8788

# Optional fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
