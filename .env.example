# Copy to .env — mise loads it automatically via [env] in mise.toml
# Never commit real secrets.

# Meta Model API (Muse Wonder / Spark / transcription)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Agent runtime
CHAIR_AGENT_HOST=127.0.0.1
CHAIR_AGENT_PORT=8787
CHAIR_PLANNER_MODEL=muse-wonder-1.0
CHAIR_EXECUTOR_MODEL=muse-spark-1.3-contributor
CHAIR_VERIFIER_MODEL=muse-spark-1.3-contributor

# Model sidecar (SAM family + ffmpeg helpers)
CHAIR_SIDECAR_HOST=127.0.0.1
CHAIR_SIDECAR_PORT=8788
CHAIR_SIDECAR_DEVICE=cuda
CHAIR_WEIGHTS_DIR=./data/weights
# SAM 3 runner: an executable outside the repo that turns a prompt into a
# matte track. See the MODEL_TOOLS protocol note in services/sidecar.
CHAIR_SAM3_RUNNER=
# Allowed origins for CORS (comma-separated). Shared with the agent service.
# Defaults to http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
CHAIR_ALLOWED_ORIGINS=

# Desktop ↔ services
CHAIR_PROJECTS_DIR=./data/projects
CHAIR_PROXY_DIR=./data/proxies
VITE_AGENT_URL=http://127.0.0.1:8787
VITE_SIDECAR_URL=http://127.0.0.1:8788

# Optional fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
