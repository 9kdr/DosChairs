{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/9kdr/DosChairs/schemas/changeset.schema.json",
  "title": "ChairChangeset",
  "description": "A proposed diff against the timeline IR. Nothing is applied until the editor accepts items.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "baseRevision", "items"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string" },
    "baseRevision": { "type": "string" },
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "rationale", "status"],
      "properties": {
        "id": { "type": "string" },
        "op": {
          "enum": [
            "add_clip",
            "remove_clip",
            "trim",
            "ripple",
            "move",
            "set_speed",
            "add_transition",
            "remove_transition",
            "add_marker",
            "remove_marker",
            "add_effect",
            "remove_effect",
            "add_track",
            "remove_track",
            "set_gain",
            "mute_clip"
          ]
        },
        "targetId": { "type": "string" },
        "beatId": { "type": "string" },
        "specRef": {
          "type": "string",
          "description": "Effect spec id for add_effect items. Resolves to schemas/effect-spec.schema.json."
        },
        "rationale": { "type": "string" },
        "patch": { "type": "object" },
        "status": { "enum": ["pending", "accepted", "rejected"] }
      }
    }
  }
}
