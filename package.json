{
  "name": "chair",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic, non-destructive video editing that learns your style",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @chair/desktop dev",
    "dev:agent": "uv run --package chair-agent python -m chair_agent",
    "dev:sidecar": "uv run --package chair-sidecar python -m chair_sidecar",
    "lint:py": "uv run ruff check services adapters",
    "test:py": "uv run pytest",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:schemas": "node scripts/validate-schemas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "node tools/codegen/generate-from-schemas.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
